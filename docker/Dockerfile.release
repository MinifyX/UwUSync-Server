# syntax=docker/dockerfile:1.7
#
# Packages the binaries CI built before: dist/amd64/uwusync-server and
# dist/arm64/uwusync-server. docker/Dockerfile builds the same image from source.

# The preparation runs on the machine that builds, whatever the image is for: it only copies and
# sets modes, so nothing has to be emulated. Pinned by digest, like the runtime below — this stage
# holds the binary for a moment, and must be exactly the image that was looked at.
FROM --platform=$BUILDPLATFORM debian:trixie-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a AS prep
ARG TARGETARCH
COPY dist/${TARGETARCH}/uwusync-server /usr/local/bin/uwusync-server
# uwussh-server is its name from when it was UwUSSH Server, for a compose.yaml or a habit from then.
RUN chmod 755 /usr/local/bin/uwusync-server \
 && ln -s uwusync-server /usr/local/bin/uwussh-server \
 && install -d -o 10001 -g 10001 /data

# Distroless, pinned by digest: see docker/Dockerfile for why.
FROM gcr.io/distroless/cc-debian13@sha256:159783207c2cd44c2aa5715961d13c8612368ac9bd450f887e3f08fc8ea461e3
COPY --from=prep /usr/local/bin/ /usr/local/bin/
COPY --from=prep --chown=10001:10001 /data /data
USER 10001:10001
ENV UWUSYNC_DATA=/data \
    UWUSYNC_LISTEN=0.0.0.0:8443 \
    HOME=/data
VOLUME /data
EXPOSE 8443
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --start-interval=2s --retries=3 \
    CMD ["/usr/local/bin/uwusync-server", "health"]
ENTRYPOINT ["/usr/local/bin/uwusync-server"]
CMD ["serve"]
