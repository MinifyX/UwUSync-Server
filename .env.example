# How your devices reach this server: a name or an address, with the port. nas.lan:8443,
# 192.168.1.20:8443 or a Tailscale name all work. It goes into the setup code and the certificate.
# Behind a reverse proxy it is the https address the proxy answers on: https://sync.example.com
UWUSYNC_PUBLIC=nas.lan:8443

# Image tag: latest (stable releases), beta (every release), edge (every commit on main)
# or an exact version like 0.1.0. sudo bash update.sh --version <tag> switches it.
UWUSYNC_VERSION=latest

# Where the server listens on this machine: a port, or an address:port like 127.0.0.1:8443.
# install.sh looks before it starts and asks when 8443 is taken.
UWUSYNC_BIND=8443

# Who may make an account: invite (with a code from `uwusync-server invite`; the first start
# prints one), open (anyone who reaches the server) or closed (nobody new).
UWUSYNC_REGISTRATION=invite

# auto: the server makes its own certificate, and your devices pin its fingerprint the way an
# SSH client pins a host key. off: a reverse proxy in front does TLS. Then set
# UWUSYNC_TRUST_FORWARDED=on as well, so the rate limits count devices and not the proxy, and
# only then: anyone can send that header to a server that believes it.
UWUSYNC_TLS=auto
UWUSYNC_TRUST_FORWARDED=off

# Once a day the server asks GitHub whether there is a newer release, and says so in its log.
# It is the only connection the server opens on its own; off stops it.
UWUSYNC_UPDATE_CHECK=on

# How many accounts the server takes, and what one account may hold. A vault of hosts, keys and
# snippets is a few megabytes; these leave room for a hundred times that.
#UWUSYNC_MAX_ACCOUNTS=100
#UWUSYNC_ACCOUNT_MAX_RECORDS=100000
#UWUSYNC_ACCOUNT_MAX_MB=256

# What all accounts and teams together may hold, in megabytes. The server keeps a week of nightly backups,
# each a whole copy, so the disk needs room for about eight times this; it skips a backup rather
# than fill the disk.
#UWUSYNC_SERVER_MAX_MB=2048

# Teams: vaults that several accounts share, sealed with a key only their members have. off for
# none at all. UWUSYNC_TEAM_CREATION=none lets nobody create a new one, and those there are go on
# working. A team may hold what one account may hold, beside its members' own vaults.
#UWUSYNC_TEAMS=on
#UWUSYNC_TEAM_CREATION=all
#UWUSYNC_MAX_TEAMS_PER_ACCOUNT=10
#UWUSYNC_MAX_TEAM_MEMBERS=50

# Connections at once, from everybody and from one address. A household of devices behind one
# router needs a few each. Behind a proxy only the total counts: every connection is the proxy's.
#UWUSYNC_MAX_CONNECTIONS=512
#UWUSYNC_MAX_CONNECTIONS_PER_IP=32

# Signing in with UwUAuth: pair with `uwusync-server uwuauth pair <address> <code>` (docs/sso.md).
# For a UwUAuth behind a private CA, the path of its root certificate (PEM) inside the container,
# mounted there by you.
#UWUSYNC_UWUAUTH_CA=
